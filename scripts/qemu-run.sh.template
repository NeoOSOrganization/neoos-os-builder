#!/bin/bash
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# A real graphical window, no timeout: this is the "boot interactively
# in QEMU" launcher the top-level README promises (`make run`), not a
# headless check -- that's `make test`, which supplies its own
# -display none/timeout separately. -serial file:... still captures a
# log for debugging; it is not how a human interacts with the machine
# here (the QEMU window and its keyboard are).
qemu-system-x86_64 -cpu Nehalem -boot order=d \
  -cdrom "$SCRIPT_DIR/@ISO@" \
  -drive file="$SCRIPT_DIR/disk1.img",format=raw \
  -drive file="$SCRIPT_DIR/disk2.img",format=raw \
  -vga std -serial file:"$SCRIPT_DIR/qemu.log"
echo "Machine stopped -- log: $SCRIPT_DIR/qemu.log"
